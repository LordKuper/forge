{
  "contract_version": "1.1.0",
  "rules": {
    "public_requires_both_surfaces": true,
    "presentation_business_orchestration": false,
    "shared_permissions": true,
    "mutations_require": ["validation", "authorization", "expected_state_version", "idempotency_key", "confirmation_when_required"]
  },
  "capabilities": [
    {
      "id": "project.snapshot",
      "kind": "query",
      "contract": "GetProjectSnapshot",
      "events": ["ProjectSnapshotInvalidated"],
      "cli": "forge status [--json]",
      "desktop": "Dashboard/Refresh",
      "permission": "read_redacted",
      "acceptance": "project-snapshot-parity"
    },
    {
      "id": "project.initialize",
      "kind": "command",
      "contract": "InitializeProject",
      "events": ["ProjectInitialized"],
      "cli": "forge init --project-root <absolute-path> [--yes]",
      "desktop": "ProjectPicker/Initialize",
      "permission": "project_write_confirm",
      "acceptance": "project-init-parity"
    },
    {
      "id": "control.events",
      "kind": "query",
      "contract": "ReadControlEvents",
      "events": ["ControlEventAvailable"],
      "cli": "forge events [--after <cursor>] [--follow] [--json]",
      "desktop": "LiveUpdates/Poll",
      "permission": "read_redacted",
      "acceptance": "control-events-parity"
    },
    {
      "id": "sprint.manage",
      "kind": "command",
      "contract": "CreateRunResumeCancelRebaseSprint",
      "events": ["SprintChanged"],
      "cli": "forge sprint <create|run|resume|cancel|rebase>",
      "desktop": "Sprints/Actions",
      "permission": "workflow_mutate",
      "acceptance": "sprint-lifecycle-parity"
    },
    {
      "id": "attempt.supersede",
      "kind": "command",
      "contract": "SupersedeAttempt",
      "events": ["AttemptSuperseded", "AttemptChanged"],
      "cli": "forge attempt supersede <attempt-id> --instruction-file <path|->",
      "desktop": "AttemptDetails/Supersede",
      "permission": "human_attempt_supersede_confirm",
      "acceptance": "attempt-supersession-parity"
    },
    {
      "id": "workflow.review",
      "kind": "command",
      "contract": "ResolveHumanGateWithContext",
      "events": ["GateResolved", "FindingChanged"],
      "cli": "forge gate <approve|reject>",
      "desktop": "Review/ResolveGate",
      "permission": "human_gate_confirm",
      "acceptance": "human-gate-parity"
    },
    {
      "id": "configuration.manage",
      "kind": "command",
      "contract": "GetSetScopedConfiguration",
      "events": ["ConfigurationChanged"],
      "cli": "forge config <user|project|show>",
      "desktop": "Settings/GetSet",
      "permission": "scope_write",
      "acceptance": "configuration-parity"
    },
    {
      "id": "project.sync_validate",
      "kind": "command",
      "contract": "SyncOrValidateProject",
      "events": ["ValidationCompleted", "DriftDetected"],
      "cli": "forge <sync|validate>",
      "desktop": "ProjectHealth/SyncValidate",
      "permission": "project_write_for_sync",
      "acceptance": "sync-validation-parity"
    },
    {
      "id": "integration.skill",
      "kind": "command",
      "contract": "GenerateInstallAgentIntegration",
      "events": ["AgentIntegrationChanged"],
      "cli": "forge integration skill <generate|install|remove>",
      "desktop": "Settings/AgentIntegration",
      "permission": "integration_write_confirm",
      "acceptance": "agent-integration-parity"
    },
    {
      "id": "provider.health",
      "kind": "query",
      "contract": "GetProviderHealth",
      "events": ["ProviderToolchainChanged"],
      "cli": "forge models [--json] [--refresh]",
      "desktop": "Providers/Refresh",
      "permission": "read",
      "acceptance": "provider-health-parity"
    },
    {
      "id": "observability.inspect",
      "kind": "query",
      "contract": "GetSafeEventsLogsMetrics",
      "events": ["DiagnosticEventRecorded"],
      "cli": "forge inspect <events|logs|metrics>",
      "desktop": "Diagnostics/Open",
      "permission": "read_redacted",
      "acceptance": "observability-parity"
    },
    {
      "id": "diagnostics.bundle",
      "kind": "command",
      "contract": "CreateSafeDiagnosticBundle",
      "events": ["DiagnosticBundleCreated"],
      "cli": "forge doctor --bundle",
      "desktop": "Diagnostics/CreateBundle",
      "permission": "diagnostic_export_confirm",
      "acceptance": "diagnostic-bundle-parity"
    },
    {
      "id": "quality.evaluate",
      "kind": "command",
      "contract": "RunEvaluation",
      "events": ["EvaluationCompleted"],
      "cli": "forge eval",
      "desktop": "Quality/RunEvaluation",
      "permission": "execute_tools_confirm",
      "acceptance": "evaluation-parity"
    }
  ]
}

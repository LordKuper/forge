{
  "contract_version": "1.4.0",
  "rules": {
    "public_requires_both_surfaces": true,
    "presentation_business_orchestration": false,
    "shared_permissions": true,
    "mutations_require": ["validation", "authorization", "expected_state_version", "idempotency_key", "confirmation_when_required"]
  },
  "capabilities": [
    {
      "id": "project.snapshot",
      "kind": "query",
      "contract": "GetProjectSnapshot",
      "events": ["ProjectSnapshotInvalidated"],
      "cli": "forge status [--detail summary|full] [--sprint <id>] [--json]",
      "desktop": "Dashboard/Refresh",
      "permission": "read_redacted",
      "acceptance": "project-snapshot-parity",
      "note": "`forge tree [--sprint <id>] [--json]` and `forge sprint inspect <id> [--json]` are additional local projections of this same query (ADR 0005) — not separate capabilities, and not covered by the automated CLI-surface parity check below. The Desktop dashboard's sprint tree and sprint detail views are their counterpart and render the same shared lines."
    },
    {
      "id": "project.initialize",
      "kind": "command",
      "contract": "InitializeProject",
      "events": ["ProjectInitialized"],
      "cli": "forge init --project-root <absolute-path> [--yes]",
      "desktop": "ProjectPicker/Initialize",
      "permission": "project_write_confirm",
      "acceptance": "project-init-parity"
    },
    {
      "id": "control.events",
      "kind": "query",
      "contract": "ReadControlEvents",
      "events": ["ControlEventAvailable"],
      "cli": "forge events [--after <cursor>] [--follow] [--json]",
      "desktop": "LiveUpdates/Poll",
      "permission": "read_redacted",
      "acceptance": "control-events-parity"
    },
    {
      "id": "sprint.manage",
      "kind": "command",
      "contract": "CreateRunResumeCancelSprint",
      "events": ["SprintChanged"],
      "cli": "forge sprint <create|run|resume|cancel>",
      "desktop": "Sprints/Actions",
      "permission": "workflow_mutate",
      "acceptance": "sprint-lifecycle-parity",
      "note": "`forge sprint inspect` shares the `sprint` command group but belongs to project.snapshot (a query), not this mutation capability. `forge sprint rebase` is a separate capability (`sprint.rebase`) below, not one of this id's verbs."
    },
    {
      "id": "sprint.rebase",
      "kind": "command",
      "contract": "RebaseSprint",
      "events": ["SprintChanged"],
      "cli": "forge sprint rebase",
      "desktop": "Sprints/Rebase",
      "permission": "workflow_mutate",
      "acceptance": "sprint-rebase-parity",
      "note": "Not implemented on either surface. `SprintGitIsolation.RebaseAttemptAsync` (the git-level primitive this would wrap) already exists but has no reachable trigger: it recovers from a concurrent-integration race that can only occur once a node executor drives attempts through `SprintGitIsolation.IntegrateAsync`, and no executor exists yet (ADR 0020, ADR 0027)."
    },
    {
      "id": "attempt.supersede",
      "kind": "command",
      "contract": "SupersedeAttempt",
      "events": ["AttemptSuperseded", "AttemptChanged"],
      "cli": "forge attempt supersede <attempt-id> --instruction-file <path|->",
      "desktop": "AttemptDetails/Supersede",
      "permission": "human_attempt_supersede_confirm",
      "acceptance": "attempt-supersession-parity"
    },
    {
      "id": "workflow.review",
      "kind": "command",
      "contract": "ResolveHumanGateWithContext",
      "events": ["GateResolved", "FindingChanged"],
      "cli": "forge gate <approve|reject>",
      "desktop": "Review/ResolveGate",
      "permission": "human_gate_confirm",
      "acceptance": "human-gate-parity"
    },
    {
      "id": "workflow.confirm",
      "kind": "command",
      "contract": "ConfirmNode",
      "events": ["ConfirmationRecorded", "SprintChanged"],
      "cli": "forge confirm <confirmed|not-confirmed> --sprint <id> --definition-of-done <text> --evidence-kind <inspection|execution|existing-check> --evidence <text> [--node <id>] [--yes]",
      "desktop": "Confirmation/RecordOutcome",
      "permission": "human_confirmation_confirm",
      "acceptance": "confirmation-parity",
      "note": "CLI-only for now, matching `workflow.review`/`attempt.supersede`'s own first slice (ADR 0019): not yet in `CapabilityIds.Implemented`, so `SurfaceParityTests`' Desktop-parity checks do not yet require a matching Desktop control. Confirms a `NodeRole.Confirmation` node's own attempt lifecycle (no executor exists for this role -- `ExecutionProfilePolicy.PhaseFor` returns null for it) rather than through a human gate."
    },
    {
      "id": "workflow.test_work",
      "kind": "command",
      "contract": "RecordTestWork",
      "events": ["TestWorkRecorded", "SprintChanged"],
      "cli": "forge test-work <added|no-new-tests> --sprint <id> --justification <text> [--node <id>] [--yes]",
      "desktop": "TestWork/RecordOutcome",
      "permission": "human_test_work_confirm",
      "acceptance": "test-work-parity",
      "note": "CLI-only for now, same reason as `workflow.confirm` above: not yet in `CapabilityIds.Implemented`. Settles a `NodeRole.TestWork` node's own attempt lifecycle (no executor exists for this role either -- `ExecutionProfilePolicy.PhaseFor` returns null for it too) rather than through a human gate. Unlike `workflow.confirm`, no downstream eligibility gate reads the recorded artifact's content -- `review`'s own graph dependency on this node is satisfied by the node reaching `succeeded` alone."
    },
    {
      "id": "configuration.manage",
      "kind": "command",
      "contract": "GetSetScopedConfiguration",
      "events": ["ConfigurationChanged"],
      "cli": "forge config <user|project|show>",
      "desktop": "Settings/GetSet",
      "permission": "scope_write",
      "acceptance": "configuration-parity"
    },
    {
      "id": "project.sync_validate",
      "kind": "command",
      "contract": "SyncOrValidateProject",
      "events": ["ValidationCompleted", "DriftDetected"],
      "cli": "forge <sync|validate>",
      "desktop": "ProjectHealth/SyncValidate",
      "permission": "project_write_for_sync",
      "acceptance": "sync-validation-parity"
    },
    {
      "id": "integration.skill",
      "kind": "command",
      "contract": "GenerateInstallAgentIntegration",
      "events": ["AgentIntegrationChanged"],
      "cli": "forge integration skill <generate|install|remove>",
      "desktop": "Settings/AgentIntegration",
      "permission": "integration_write_confirm",
      "acceptance": "agent-integration-parity"
    },
    {
      "id": "provider.health",
      "kind": "query",
      "contract": "GetProviderHealth",
      "events": ["ProviderToolchainChanged"],
      "cli": "forge models [--json] [--refresh]",
      "desktop": "Providers/Refresh",
      "permission": "read",
      "acceptance": "provider-health-parity"
    },
    {
      "id": "observability.inspect",
      "kind": "query",
      "contract": "GetSafeEventsLogsMetrics",
      "events": ["DiagnosticEventRecorded"],
      "cli": "forge inspect <events|logs|metrics>",
      "desktop": "Diagnostics/Open",
      "permission": "read_redacted",
      "acceptance": "observability-parity"
    },
    {
      "id": "diagnostics.bundle",
      "kind": "command",
      "contract": "CreateSafeDiagnosticBundle",
      "events": ["DiagnosticBundleCreated"],
      "cli": "forge doctor --bundle",
      "desktop": "Diagnostics/CreateBundle",
      "permission": "diagnostic_export_confirm",
      "acceptance": "diagnostic-bundle-parity"
    },
    {
      "id": "quality.evaluate",
      "kind": "command",
      "contract": "RunEvaluation",
      "events": ["EvaluationCompleted"],
      "cli": "forge eval",
      "desktop": "Quality/RunEvaluation",
      "permission": "execute_tools_confirm",
      "acceptance": "evaluation-parity"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/handoff.schema.json",
  "title": "Forge structured handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "sprint_id", "node_id", "base_sha", "summary", "decisions", "artifacts", "open_risks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"type": "string", "format": "uuid"},
    "sprint_id": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "summary": {"type": "string", "minLength": 1},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "open_risks": {"type": "array", "items": {"type": "string"}},
    "next_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "media_type", "audience", "policy_snapshot_hash", "generator_version"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "media_type": {"type": "string"},
        "audience": {"enum": ["user_facing", "agent_facing", "machine"]},
        "language": {"type": ["string", "null"], "pattern": "^(?!.*-([a-z0-9]{5,8}|[0-9][a-z0-9]{3})(?:-[a-z0-9]{1,8})*-\\1(?:-|$))(?!.*-([0-9a-wy-z])(?:-[a-z0-9]{1,8})*-\\2(?:-|$))(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4}|[a-z]{5,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$"},
        "policy_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"}
      },
      "allOf": [
        {
          "if": {"properties": {"audience": {"enum": ["user_facing", "agent_facing"]}}, "required": ["audience"]},
          "then": {"required": ["language"], "properties": {"language": {"type": "string"}}}
        },
        {
          "if": {"properties": {"audience": {"const": "machine"}}, "required": ["audience"]},
          "then": {"properties": {"language": {"type": "null"}}}
        }
      ]
    }
  }
}

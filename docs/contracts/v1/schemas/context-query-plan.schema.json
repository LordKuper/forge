{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/context-query-plan.schema.json",
  "title": "Declarative context-query plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "operations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "kind"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"},
          "kind": {"enum": ["git_show", "git_grep"]},
          "path": {"type": "string", "minLength": 1},
          "pattern": {"type": "string", "minLength": 1},
          "path_scope": {"type": "string", "minLength": 1},
          "max_result_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "git_show"}}, "required": ["kind"]},
            "then": {"required": ["path"]}
          },
          {
            "if": {"properties": {"kind": {"const": "git_grep"}}, "required": ["kind"]},
            "then": {"required": ["pattern"]}
          }
        ]
      }
    }
  }
}

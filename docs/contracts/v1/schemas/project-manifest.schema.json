{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/project-manifest.schema.json",
  "title": "Forge project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "workflow", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "format": "uuid"},
    "workflow": {"const": "implementation-critical"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "language": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_facing", "agent_facing"],
          "properties": {
            "user_facing": {"$ref": "#/$defs/language"},
            "agent_facing": {"$ref": "#/$defs/language"}
          }
        }
      }
    }
  },
  "$defs": {
    "language": {"type": "string", "pattern": "^(?!.*-([a-z0-9]{5,8}|[0-9][a-z0-9]{3})(?:-[a-z0-9]{1,8})*-\\1(?:-|$))(?!.*-([0-9a-wy-z])(?:-[a-z0-9]{1,8})*-\\2(?:-|$))(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4}|[a-z]{5,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$"}
  }
}

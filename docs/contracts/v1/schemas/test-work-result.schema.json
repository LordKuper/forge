{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/test-work-result.schema.json",
  "title": "Forge test-work result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_work_id", "sprint_id", "node_id", "outcome", "justification", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "test_work_id": {"type": "string", "format": "uuid"},
    "sprint_id": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["tests_added", "no_new_tests_justified"]},
    "justification": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 0},
    "superseded_at_revision": {"type": "integer", "minimum": 1},
    "superseded_at": {"type": "string", "format": "date-time"}
  }
}

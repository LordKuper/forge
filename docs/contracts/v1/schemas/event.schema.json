{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/event.schema.json",
  "title": "Forge event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "occurred_at", "type", "aggregate", "message_key", "arguments"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "event_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$"},
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {"enum": ["project", "sprint", "node", "attempt", "provider", "update"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "message_key": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "arguments": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": "string", "format": "uuid"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diff": {"$ref": "#/$defs/diff_payload"},
        "tool_use": {"$ref": "#/$defs/tool_use_payload"}
      }
    }
  },
  "$defs": {
    "diff_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_changed", "insertions", "deletions", "files", "elided_files"],
      "properties": {
        "files_changed": {"type": "integer", "minimum": 0},
        "insertions": {"type": "integer", "minimum": 0},
        "deletions": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "added", "deleted", "change_kind"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "added": {"type": "integer", "minimum": 0},
              "deleted": {"type": "integer", "minimum": 0},
              "change_kind": {"enum": ["added", "deleted", "modified", "renamed", "binary"]}
            }
          }
        },
        "elided_files": {"type": "integer", "minimum": 0}
      }
    },
    "tool_use_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls", "commands", "edits", "calls", "elided_calls", "unmapped_items"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "commands": {"type": "integer", "minimum": 0},
        "edits": {"type": "integer", "minimum": 0},
        "calls": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["command", "edit"]},
              "target": {"type": "string", "minLength": 1},
              "duration_ms": {"type": "integer", "minimum": 0},
              "exit_code": {"type": "integer"},
              "succeeded": {"type": "boolean"}
            }
          }
        },
        "elided_calls": {"type": "integer", "minimum": 0},
        "unmapped_items": {"type": "integer", "minimum": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/user-config.schema.json",
  "title": "Forge user configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "interaction"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {"$ref": "#/$defs/language"},
        "interaction": {"$ref": "#/$defs/language"},
        "llm": {"$ref": "#/$defs/language"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"confirm_destructive": {"type": "boolean"}}
    }
  },
  "$defs": {"language": {"type": "string", "pattern": "^(?!.*-([a-z0-9]{5,8}|[0-9][a-z0-9]{3})(?:-[a-z0-9]{1,8})*-\\1(?:-|$))(?!.*-([0-9a-wy-z])(?:-[a-z0-9]{1,8})*-\\2(?:-|$))(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4}|[a-z]{5,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/user-config.schema.json",
  "title": "Forge user configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "interaction"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0"]},
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {"$ref": "#/$defs/language"},
        "interaction": {"$ref": "#/$defs/language"},
        "llm": {"$ref": "#/$defs/language"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirm_destructive": {"type": "boolean"},
        "auto_approve_gate": {"type": "boolean"}
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "The exact set of providers that may be used at all (ADR 0008). Omitted selects every registered provider in composition order; [] blocks model work. This array's order is also the routing order, but only while 'priority' is empty (ADR 0067).",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "priority": {
          "description": "Preferred routing order (ADR 0067). Governs order only: it never enables or disables a provider, and an id listed here that is not enabled is skipped rather than rejected. When non-empty it supersedes the ordering of 'enabled' -- the effective user order is the ids listed here that are in the effective enabled set, in this order, followed by the remaining enabled ids in their existing relative order. Empty (the default) leaves ADR 0008's rule untouched. A frozen project profile still narrows and reorders on top of the result.",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effort": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidebar_collapsed": {"type": "boolean"},
        "theme": {"enum": ["dark", "light", "system"]}
      }
    }
  },
  "$defs": {"language": {"type": "string", "pattern": "^(?!.*-([a-z0-9]{5,8}|[0-9][a-z0-9]{3})(?:-[a-z0-9]{1,8})*-\\1(?:-|$))(?!.*-([0-9a-wy-z])(?:-[a-z0-9]{1,8})*-\\2(?:-|$))(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4}|[a-z]{5,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$"}}
}

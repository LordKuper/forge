{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/language-pack.schema.json",
  "title": "Forge language pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "culture", "fallback", "catalog_version", "capabilities", "messages"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "culture": {"type": "string", "minLength": 2},
    "fallback": {"const": "en"},
    "catalog_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["ui", "interaction", "llm", "artifact_user_facing", "artifact_agent_facing"]}
    },
    "messages": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/message"}
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "placeholders"],
      "properties": {
        "template": {"type": "string"},
        "placeholders": {
          "type": "object",
          "additionalProperties": {"enum": ["string", "integer", "number", "boolean", "date_time"]}
        },
        "plural_selectors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "select_selectors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/v1/provider-health.schema.json",
  "title": "ProviderHealth v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "registered", "enabled", "state", "diagnostic_code"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "registered": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "state": {"enum": ["missing", "installing", "updating", "rechecking", "ready", "failed", null]},
        "version": {"type": ["string", "null"]},
        "update_available": {"type": ["boolean", "null"]},
        "authentication": {"enum": ["required", "check_failed", "ready", null]},
        "diagnostic_code": {"type": "string", "minLength": 1}
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Not itself an OS-specific adapter; this composition root selects between adapters at
         runtime by OS (see Program.cs), the same "OS detection to select an adapter" carve-out
         PlatformUpdateStrategyResolver uses (AGENTS.md Portability). Marked ForgeOsAdapter so the
         architecture tests treat it like every other composition root (Forge.Cli.Windows,
         Forge.Host.Windows, Forge.Desktop): exempt from the neutral/no-adapter-reference rule,
         since a composition root's whole purpose is wiring adapters together. -->
    <ForgeOsAdapter>true</ForgeOsAdapter>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Forge.Host.Runtime\Forge.Host.Runtime.csproj" />
    <!-- Plain net10.0, no OS-specific TFM (see Forge.Runtime.Posix.csproj); safe to reference
         unconditionally from this single-TFM project on every OS. Program.cs only calls into it
         when actually running on Linux/macOS. -->
    <ProjectReference Include="..\Forge.Runtime.Posix\Forge.Runtime.Posix.csproj" />
  </ItemGroup>
</Project>

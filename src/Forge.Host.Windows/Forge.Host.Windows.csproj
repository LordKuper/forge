<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Forge.Host</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ForgeOsAdapter>true</ForgeOsAdapter>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Forge.Host.Runtime\Forge.Host.Runtime.csproj" />
    <ProjectReference Include="..\Forge.Runtime.Windows\Forge.Runtime.Windows.csproj" />
    <ProjectReference Include="..\Forge.Providers.Codex.Windows\Forge.Providers.Codex.Windows.csproj" />
    <ProjectReference Include="..\Forge.Providers.Claude.Windows\Forge.Providers.Claude.Windows.csproj" />
    <!-- Only for IPlatformPreflight (WindowsPlatformPreflight): without it StartupPipeline's
         platform check always fails here, falling back to ForgeHost.AddForgeCore's
         UnsupportedPlatformPreflight — matching the same registration Forge.Cli.Windows and
         Forge.Desktop already make. -->
    <ProjectReference Include="..\Forge.Updater.Windows\Forge.Updater.Windows.csproj" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Forge.Desktop.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Nocturne design tokens (docs/plans/desktop-workspace-redesign.md visual pass).
           Values are ported 1:1 from the design system's styles.css; do not hand-tune a value here
           without also updating it there. Colors only, no Text attribute appears in this file, so
           ArchitectureTests.HostsDoNotContainHardCodedLabelText is unaffected. -->

      <Color x:Key="ColorBg">#161826</Color>
      <Color x:Key="ColorSurface">#232532</Color>
      <!-- color-mix(in srgb, the page bg color 82%, #000) from styles.css: the sidebar's own,
           slightly-darker-than-page ground. -->
      <Color x:Key="ColorSidebarBg">#12141F</Color>
      <Color x:Key="ColorText">#E9E9ED</Color>
      <Color x:Key="ColorAccent">#9184D9</Color>
      <Color x:Key="ColorDivider">#29E9E9ED</Color>

      <!-- Only the ramp steps the Nocturne pass actually reads are declared (PR #112 review finding
           8): a token nothing references is dead weight, so the unused steps are left in the design
           system's styles.css rather than mirrored here, and are added back one at a time as a
           surface genuinely needs them. -->
      <Color x:Key="ColorNeutral200">#E4E7F5</Color>
      <Color x:Key="ColorNeutral300">#CFD3E5</Color>
      <Color x:Key="ColorNeutral400">#B2B6CA</Color>
      <Color x:Key="ColorNeutral500">#9397AB</Color>
      <Color x:Key="ColorNeutral600">#75798C</Color>
      <Color x:Key="ColorNeutral700">#595D6C</Color>

      <Color x:Key="ColorAccent800">#423A6A</Color>
      <Color x:Key="ColorAccent900">#2B2741</Color>

      <!-- Status colors: hardcoded per-instance in the mockup (not part of a ramp) rather than
           tokens, so they're kept as their own resources instead of folded into the ramps above. -->
      <Color x:Key="ColorStatusGreen">#8BAB8A</Color>
      <Color x:Key="ColorStatusGreenText">#A8C9A7</Color>
      <Color x:Key="ColorStatusAmber">#CBB27A</Color>
      <Color x:Key="ColorStatusAmberText">#E0CD9C</Color>
      <Color x:Key="ColorStatusRed">#CF7D78</Color>
      <Color x:Key="ColorStatusRedText">#E3A9A5</Color>
      <Color x:Key="ColorStatusBlue">#86A2C4</Color>

      <!-- Danger-zone tint: color-mix(in srgb, #cf7d78 N%, transparent) baked as alpha-blended hex
           (7%/34%/55%, i.e. 0x12/0x57/0x8C) since MAUI Color has no color-mix equivalent. Genuinely
           missing from the ramps above: the mockup's destructive-action card/border/button are the
           only place this exact tint is used (WorkspaceShellPage.ProjectSettings.cs's "remove
           project"-equivalent action). -->
      <Color x:Key="ColorDangerBg">#12CF7D78</Color>
      <Color x:Key="ColorDangerBorder">#57CF7D78</Color>
      <Color x:Key="ColorDangerBorderStrong">#8CCF7D78</Color>

      <!-- Spacing scale (density 0.7x baked in, per readme.md), in device-independent units. Same
           "declare only what is read" rule as the ramps above (PR #112 review finding 8): the wider
           scale's unused steps, and the radius scale, are not mirrored here. The four corner radii
           this pass uses stay literal on the Style setters below: a Setter can only reach a radius
           token through an implicit double conversion, which nothing in this repository can verify
           without a live MAUI run. Add the radius tokens back together with that verification. -->
      <x:Double x:Key="Space1">3</x:Double>
      <x:Double x:Key="Space2">6</x:Double>
      <x:Double x:Key="Space3">8</x:Double>
      <x:Double x:Key="Space4">11</x:Double>

      <!-- Font family aliases registered in MauiProgram.ConfigureFonts, plus the one system font this
           app asks for by name. FontMono is a Windows system font, not a bundled resource: this
           project is an OS adapter (ForgeOsAdapter=true in Forge.Desktop.csproj), and naming it once
           here is what keeps that choice, and any future fallback stack, in a single place. -->
      <x:String x:Key="FontHeading">InterMedium</x:String>
      <x:String x:Key="FontBody">InterRegular</x:String>
      <x:String x:Key="FontIcon">Phosphor</x:String>
      <x:String x:Key="FontMono">Consolas</x:String>

      <!-- Page default -->
      <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBg}" />
      </Style>

      <!-- Implicit defaults so any control not explicitly styled still reads as Nocturne, not
           platform default white-on-black/black-on-white. -->
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorNeutral600}" />
      </Style>
      <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorNeutral600}" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource ColorAccent}" />
      </Style>
      <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="ThumbColor" Value="{StaticResource ColorText}" />
      </Style>

      <!-- Headings: Inter medium, per readme.md ("hierarchy here is size and space", never bolded
           past weight 500). -->
      <Style x:Key="HeadingLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontSize" Value="15" />
      </Style>
      <Style x:Key="MutedLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral500}" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <!-- ui-monospace counterpart for the mockup's timestamps, counters, and technical detail rows. -->
      <Style x:Key="MonoLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral600}" />
        <Setter Property="FontSize" Value="10.5" />
      </Style>
      <!-- Phosphor glyph host: pair with Forge.Desktop.Theme.IconGlyphs for the Text value. -->
      <Style x:Key="IconGlyphStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}" />
        <Setter Property="TextColor" Value="{StaticResource ColorNeutral500}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>

      <!-- Buttons: outlined, never solid-filled (readme.md "Direction"). -->
      <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="VisualStateManager.VisualStateGroups">
          <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="PointerOver">
                <VisualState.Setters>
                  <Setter Property="BackgroundColor" Value="#1F9184D9" />
                </VisualState.Setters>
              </VisualState>
              <VisualState x:Name="Pressed">
                <VisualState.Setters>
                  <Setter Property="BackgroundColor" Value="#389184D9" />
                </VisualState.Setters>
              </VisualState>
              <VisualState x:Name="Disabled">
                <VisualState.Setters>
                  <Setter Property="Opacity" Value="0.45" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateGroupList>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorDivider}" />
      </Style>
      <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="3,2" />
      </Style>

      <!-- Surface-filled content card. -->
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="Transparent" />
      </Style>
      <!-- Outlined content region (tool-call/diff/test-result panels): divider border, no fill. -->
      <Style x:Key="OutlinedPanelStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource ColorDivider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
      </Style>
      <Style x:Key="DividerBoxStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource ColorDivider}" />
        <Setter Property="HeightRequest" Value="1" />
      </Style>

      <!-- Small pill labels (tags/status chips). -->
      <Style x:Key="TagAccentStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccent800}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 99" />
        <Setter Property="Stroke" Value="Transparent" />
      </Style>

      <!-- Red-tinted destructive-action container (mockup's "Danger zone" card). -->
      <Style x:Key="DangerCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorDangerBg}" />
        <Setter Property="Stroke" Value="{StaticResource ColorDangerBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="11" />
      </Style>
      <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="TextColor" Value="{StaticResource ColorStatusRedText}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorDangerBorderStrong}" />
      </Style>

      <!-- Amber-tinted container for a pending human decision (mockup's "Permission required" /
           gate card): same color-mix-as-alpha-hex technique DangerCardStyle already uses above,
           just on the amber status hue instead of red: genuinely missing from the ramps since
           DangerCardStyle/DangerButtonStyle only ever cover the red hue. -->
      <Style x:Key="AmberCardStyle" TargetType="Border" BasedOn="{StaticResource DangerCardStyle}">
        <Setter Property="BackgroundColor" Value="#14CBB27A" />
        <Setter Property="Stroke" Value="#6ACBB27A" />
      </Style>

      <!-- Sprint-workspace timeline: the human/"operator"-authored message bubble (mockup's
           right-aligned chat bubble) needs an accent wash CardStyle's flat surface fill and
           OutlinedPanelStyle's transparent-with-divider-border don't cover: same accent-hex-with-
           alpha technique PrimaryButtonStyle's own PointerOver/Pressed states already use above. -->
      <Style x:Key="MessageBubbleStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BackgroundColor" Value="#219184D9" />
        <Setter Property="Stroke" Value="#429184D9" />
        <Setter Property="StrokeThickness" Value="1" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>

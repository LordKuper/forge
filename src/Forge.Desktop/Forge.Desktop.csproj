<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Forge</ApplicationTitle>
    <ApplicationId>dev.forge.desktop</ApplicationId>
    <ApplicationDisplayVersion>$(ForgeVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ForgeOsAdapter>true</ForgeOsAdapter>
  </PropertyGroup>
  <ItemGroup>
    <!-- The MAUI SDK's default item globs did not pick these up (verified via
         `dotnet msbuild -getItem:MauiFont` returning empty and a Release build shipping no .ttf
         files), so they're declared explicitly. -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <!-- OFL-1.1 (Inter) and MIT (Phosphor) both require their notice to travel with the binaries,
         so the notice ships next to the fonts it covers instead of only living in source. -->
    <None Update="Resources\Fonts\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <ProjectReference Include="..\Forge.Desktop.Presentation\Forge.Desktop.Presentation.csproj" />
    <ProjectReference Include="..\Forge.Providers.Claude.Windows\Forge.Providers.Claude.Windows.csproj" />
    <ProjectReference Include="..\Forge.Providers.Codex.Windows\Forge.Providers.Codex.Windows.csproj" />
    <ProjectReference Include="..\Forge.Runtime\Forge.Runtime.csproj" />
    <ProjectReference Include="..\Forge.Runtime.Windows\Forge.Runtime.Windows.csproj" />
    <ProjectReference Include="..\Forge.Updater.Windows\Forge.Updater.Windows.csproj" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Forge.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <ScrollView>
    <VerticalStackLayout Padding="32" Spacing="16">
      <Label x:Name="TitleLabel" FontSize="32" SemanticProperties.HeadingLevel="Level1" />
      <Label x:Name="StatusLabel" SemanticProperties.HeadingLevel="Level2" />
      <Label x:Name="ProjectRootLabel" />
      <Label x:Name="ProjectStateLabel" />
      <Label x:Name="StartupChecksLabel" />
      <Label x:Name="ProvidersLabel" />
      <Label x:Name="SuggestedActionsLabel" />
      <Label x:Name="SprintsLabel" />
      <Label x:Name="SprintDetailsLabel" />
      <HorizontalStackLayout Spacing="8">
        <Entry x:Name="ProjectRootEntry" WidthRequest="360" />
        <Entry x:Name="SprintIdEntry" WidthRequest="320" />
        <Button x:Name="RefreshButton" Clicked="OnRefreshClicked" />
        <Button x:Name="InitializeButton" Clicked="OnInitializeClicked" />
        <Button x:Name="RecoverButton" Clicked="OnRecoverClicked" />
      </HorizontalStackLayout>
      <Label x:Name="DiagnosticsLabel" />
      <Label x:Name="ConfigurationTitleLabel" />
      <Label x:Name="ConfigurationLabel" />
      <HorizontalStackLayout Spacing="8">
        <Picker x:Name="ConfigurationScopePicker" WidthRequest="120" />
        <Entry x:Name="ConfigurationKeyEntry" WidthRequest="240" />
        <Entry x:Name="ConfigurationValueEntry" WidthRequest="160" />
        <Button x:Name="ConfigurationSetButton" Clicked="OnConfigurationSetClicked" />
      </HorizontalStackLayout>
      <Label x:Name="ConfigurationResultLabel" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>

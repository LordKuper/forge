<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- This project's own net10.0-windows TFM is subject to the same SDK guard as the adapter projects it
         references; see the identical property on Forge.Runtime.Windows/Forge.Updater.Windows.csproj. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Installer/**/*.cs" />
    <!-- Provider adapters are Windows-only (ADR 0008); their tests exercise the real Codex/Claude
         adapters and only compile in the Windows TFM group below. -->
    <Compile Remove="ProviderAdapters/**/*.cs" />
    <!-- Depends on Forge.ProcessContainmentProbe, a Windows-TFM-only exe proving the real
         WindowsJobObjectProcessContainment guarantee against an abrupt process kill; only compiles
         in the Windows TFM group below. -->
    <Compile Remove="WindowsRuntime/**/*.cs" />
    <ProjectReference Include="..\..\src\Forge.Cli\Forge.Cli.csproj" />
    <ProjectReference Include="..\..\src\Forge.Desktop.Presentation\Forge.Desktop.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Forge.Host.Client\Forge.Host.Client.csproj" />
    <!-- The neutral stand-in composition root (ADR 0005), so the process/lease/protocol acceptance
         tests below run on Windows, Linux, and macOS without a real, Windows-only provider adapter. -->
    <ProjectReference Include="..\..\src\Forge.Host.TestHost\Forge.Host.TestHost.csproj" />
    <ProjectReference Include="..\..\src\Forge.Runtime\Forge.Runtime.csproj" />
    <!-- Plain net10.0, no OS-specific TFM (see Forge.Runtime.Posix.csproj); safe to reference
         unconditionally, matching Forge.Host.TestHost's own reference to it. Lets
         PosixProcessGroupContainmentTests exercise the real adapter directly on the portable
         ubuntu-24.04/macos-14 CI matrix, not merely compile it. -->
    <ProjectReference Include="..\..\src\Forge.Runtime.Posix\Forge.Runtime.Posix.csproj" />
    <ProjectReference Include="..\..\src\Forge.Updater\Forge.Updater.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <Compile Include="Installer/**/*.cs" />
    <Compile Include="ProviderAdapters/**/*.cs" />
    <Compile Include="WindowsRuntime/**/*.cs" />
    <!-- The real Windows durability adapter, installed by Installer/WindowsDurabilityAssemblyInitializer.cs,
         supersedes the portable fallback below; excluded here so the two module initializers never race. -->
    <Compile Remove="Support/PortableDurabilityFallback.cs" />
    <ProjectReference Include="..\..\src\Forge.Runtime.Windows\Forge.Runtime.Windows.csproj" />
    <ProjectReference Include="..\..\src\Forge.Updater.Windows\Forge.Updater.Windows.csproj" />
    <ProjectReference Include="..\..\src\Forge.Providers.Codex.Windows\Forge.Providers.Codex.Windows.csproj" />
    <ProjectReference Include="..\..\src\Forge.Providers.Claude.Windows\Forge.Providers.Claude.Windows.csproj" />
    <ProjectReference Include="..\Forge.ProcessContainmentProbe\Forge.ProcessContainmentProbe.csproj" />
  </ItemGroup>
</Project>
